# Production Environment Configuration
ENVIRONMENT=production

# API Configuration
#BASE_URL=https://api.fajimobile.com
BASE_URL=https://faji-backend-52878caa6589.herokuapp.com/
API_VERSION=v1
API_KEY=production-api-key-placeholder

# Firebase Configuration (Production)
FIREBASE_PROJECT_ID=fajimobile-prod
FIREBASE_API_KEY=production-firebase-api-key-placeholder
FIREBASE_APP_ID=production-firebase-app-id-placeholder

# Security Configuration
ENCRYPTION_KEY=production-encryption-key-placeholder
JWT_SECRET=production-jwt-secret-placeholder

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_LOGGING=false
DEBUG_MODE=false

# Third-party Services
GOOGLE_MAPS_API_KEY=production-google-maps-key-placeholder
SENTRY_DSN=