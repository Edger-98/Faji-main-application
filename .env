# Default Environment Configuration
# This file contains default values that can be overridden by environment-specific files

# App Configuration
APP_NAME=FajiMobile App
APP_VERSION=1.0.0
ENVIRONMENT=development

# API Configuration
# For Android Emulator use: http://10.0.2.2:5001
# For iOS Simulator use: http://localhost:5001
# For Physical Device use: http://YOUR_COMPUTER_IP:5001
# Production Heroku URL
API_BASE_URL=https://faji-backend-52878caa6589.herokuapp.com/
API_TIMEOUT=30000
API_VERSION=v1

# Firebase Configuration (Default/Development)
FIREBASE_PROJECT_ID=fajimobile-dev
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Security Configuration
ENABLE_LOGGING=true
ENABLE_CRASHLYTICS=false
ENABLE_ANALYTICS=false

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_DARK_MODE=true

# Storage Configuration
CACHE_DURATION_MINUTES=60
MAX_CACHE_SIZE_MB=100

# Network Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000