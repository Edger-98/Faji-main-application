# Default Environment Configuration
# This file contains default values that can be overridden by environment-specific files

# App Configuration
APP_NAME=FajiMobile App
APP_VERSION=1.0.0
ENVIRONMENT=production

# API Configuration
# ⚠️ IMPORTANT: These URLs are OVERRIDDEN by ApiConfig._useLocalhost toggle
# The toggle in lib/core/config/api_config.dart takes priority over these values
# To switch between localhost and Heroku, change the toggle in api_config.dart
# Production: https://faji-backend-52878caa6589.herokuapp.com/api/v1
# For Android Emulator use: http://10.0.2.2:5001/api/v1
# For iOS Simulator use: http://localhost:5001/api/v1
# For Physical Device use: http://YOUR_COMPUTER_IP:5001/api/v1
API_BASE_URL=https://faji-backend-52878caa6589.herokuapp.com/api/v1
API_TIMEOUT=30000
API_VERSION=v1

# Firebase Configuration (Default/Development)
FIREBASE_PROJECT_ID=fajimobile-dev
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Security Configuration
ENABLE_LOGGING=false
ENABLE_CRASHLYTICS=true
ENABLE_ANALYTICS=true

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_DARK_MODE=true

# Storage Configuration
CACHE_DURATION_MINUTES=60
MAX_CACHE_SIZE_MB=100

# Network Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Cloudinary Configuration (Image Upload)
CLOUDINARY_CLOUD_NAME=dicgz84sg
CLOUDINARY_UPLOAD_PRESET=Wj-ikwb2An-FpHwbt2tN94Lz5eU

