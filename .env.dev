# Development Environment Configuration
ENVIRONMENT=dev

# API Configuration
# For Android Emulator use: http://10.0.2.2:5001
# For iOS Simulator use: http://localhost:5001
# For Physical Device use: http://YOUR_COMPUTER_IP:5001
#BASE_URL=http://10.0.2.2:5001
BASE_URL=https://faji-backend-52878caa6589.herokuapp.com/
API_VERSION=v1
API_KEY=dev-api-key-placeholder

# Firebase Configuration (Development)
FIREBASE_PROJECT_ID=fajimobile-dev
FIREBASE_API_KEY=dev-firebase-api-key-placeholder
FIREBASE_APP_ID=dev-firebase-app-id-placeholder

# Security Configuration
ENCRYPTION_KEY=dev-encryption-key-placeholder
JWT_SECRET=dev-jwt-secret-placeholder

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_LOGGING=true
DEBUG_MODE=true

# Third-party Services
GOOGLE_MAPS_API_KEY=dev-google-maps-key-placeholder
SENTRY_DSN=