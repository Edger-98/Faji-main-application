# Development Environment Configuration
ENVIRONMENT=dev

# API Configuration
# ⚠️ NOTE: These URLs are OVERRIDDEN by ApiConfig._useLocalhost toggle
# The toggle in api_config.dart takes priority over these values
# For Android Emulator use: http://10.0.2.2:5001/api/v1
# For iOS Simulator use: http://localhost:5001/api/v1
# For Physical Device use: http://YOUR_COMPUTER_IP:5001/api/v1
BASE_URL=http://10.0.2.2:5001/api/v1
API_VERSION=v1
API_KEY=dev-api-key-placeholder

# Firebase Configuration (Development)
